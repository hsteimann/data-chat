      "correct": false,
      "sql": "WITH june_orders AS (\n  SELECT \n    p.category,\n    SUM(soi.units) AS units_ordered\n  FROM shop_order_items soi\n  JOIN shop_orders so ON soi.order_id = so.order_id\n  JOIN products p ON soi.sku = p.sku\n  WHERE so.order_date BETWEEN '2026-06-01' AND '2026-06-30'\n  GROUP BY p.category\n),\njune_returns AS (\n  SELECT \n    p.category,\n    SUM(sr.units_returned) AS units_returned\n  FROM shop_returns sr\n  JOIN products p ON sr.sku = p.sku\n  WHERE sr.return_date BETWEEN '2026-06-01' AND '2026-06-30'\n  GROUP BY p.category\n)\nSELECT \n  jo.category,\n  jo.units_ordered,\n  COALESCE(jr.units_returned, 0) AS units_returned,\n  ROUND(100.0 * COALESCE(jr.units_returned, 0) / NULLIF(jo.units_ordered, 0), 2) AS return_share_percent\nFROM june_orders jo\nLEFT JOIN june_returns jr ON jo.category = jr.category\nORDER BY return_share_percent DESC\nLIMIT 1000;",
