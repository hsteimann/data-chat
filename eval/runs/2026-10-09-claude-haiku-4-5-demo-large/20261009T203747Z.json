      "correct": false,
      "sql": "WITH june_orders AS (\n  SELECT i.sku, i.units, o.order_id\n  FROM shop_order_items i\n  JOIN shop_orders o ON o.order_id = i.order_id AND o.order_status = 'completed'\n  WHERE i.order_date BETWEEN '2026-06-01' AND '2026-06-30'\n),\nreturns_from_june AS (\n  SELECT jo.sku, COALESCE(SUM(r.units_returned), 0) AS units_returned\n  FROM june_orders jo\n  LEFT JOIN shop_returns r ON r.order_id = jo.order_id AND r.sku = jo.sku\n  GROUP BY jo.sku\n)\nSELECT p.category,\n       SUM(jo.units) AS units_ordered,\n       SUM(rf.units_returned) AS units_returned,\n       ROUND(SUM(rf.units_returned) / NULLIF(SUM(jo.units), 0), 4) AS return_share\nFROM june_orders jo\nJOIN returns_from_june rf ON rf.sku = jo.sku\nJOIN products p ON p.sku = jo.sku\nGROUP BY p.category\nORDER BY return_share DESC\nLIMIT 1000;",
