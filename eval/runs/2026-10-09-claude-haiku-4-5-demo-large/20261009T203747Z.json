      "sql": "SELECT p.brand,\n       ROUND(SUM(s.revenue_net), 2) AS revenue_net,\n       ROUND(SUM(s.units_ordered * p.cost_price_net), 2) AS purchase_cost,\n       ROUND(SUM(s.revenue_net) - SUM(s.units_ordered * p.cost_price_net), 2) AS gross_margin\nFROM shop_product_sales_daily s\nJOIN products p ON p.sku = s.sku\nWHERE s.date BETWEEN '2026-07-01' AND '2026-07-31'\nGROUP BY p.brand\nORDER BY gross_margin DESC\nLIMIT 1000",
