      "sql": "WITH june_orders AS (\n  SELECT \n    p.category,\n    SUM(soi.units) as units_ordered\n  FROM shop_order_items soi\n  JOIN shop_orders so ON soi.order_id = so.order_id\n  JOIN products p ON soi.sku = p.sku\n  WHERE so.order_date BETWEEN '2026-06-01' AND '2026-06-30'\n  GROUP BY p.category\n),\njune_returns AS (\n  SELECT \n    p.category,\n    SUM(sr.units_returned) as units_returned\n  FROM shop_returns sr\n  JOIN shop_order_items soi ON sr.order_id = soi.order_id AND sr.sku = soi.sku\n  JOIN shop_orders so ON sr.order_id = so.order_id\n  JOIN products p ON sr.sku = p.sku\n  WHERE so.order_date BETWEEN '2026-06-01' AND '2026-06-30'\n  GROUP BY p.category\n)\nSELECT \n  jo.category,\n  jo.units_ordered,\n  COALESCE(jr.units_returned, 0) as units_returned,\n  ROUND(100.0 * COALESCE(jr.units_returned, 0) / NULLIF(jo.units_ordered, 0), 2) as return_share_percent\nFROM june_orders jo\nLEFT JOIN june_returns jr ON jo.category = jr.category\nORDER BY return_share_percent DESC, jo.category\nLIMIT 1000;",
