      "sql": "WITH june_orders AS (\n  SELECT \n    p.category,\n    SUM(soi.units) as units_ordered\n  FROM shop_order_items soi\n  JOIN shop_orders so ON soi.order_id = so.order_id\n  JOIN products p ON soi.sku = p.sku\n  WHERE so.order_date BETWEEN '2026-06-01' AND '2026-06-30'\n  GROUP BY p.category\n),\njune_returns AS (\n  SELECT \n    p.category,\n    SUM(sr.units_returned) as units_returned\n  FROM shop_returns sr\n  JOIN products p ON sr.sku = p.sku\n  WHERE sr.return_date BETWEEN '2026-06-01' AND '2026-06-30'\n  GROUP BY p.category\n)\nSELECT \n  o.category,\n  o.units_ordered,\n  COALESCE(r.units_returned, 0) as units_returned,\n  ROUND(100.0 * COALESCE(r.units_returned, 0) / NULLIF(o.units_ordered, 0), 2) as return_share_percent\nFROM june_orders o\nLEFT JOIN june_returns r ON o.category = r.category\nORDER BY o.category\nLIMIT 1000;",
